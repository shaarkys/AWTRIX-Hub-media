# @name    Event trigger
# @desc    MQTT event-triggered animated scenes for the TC002 display
# @version 1.0.0
# @display 52x16
# @config topic text "MQTT topic filter" default="homey/events/+" group="MQTT"
# @config event_mode select "Event mode" default=auto options=auto,motion,mail_received,mail_collected,heat,water,doorbell,garage,dishwasher_finished,cooker_finished,washing_machine_finished,dryer_finished group="Matching"
# @config trigger_mode select "Trigger mode" default=pulse options=pulse,edge group="Matching"
# @config payload_field text "Activity JSON field" default="" group="Matching" help="Empty uses value or active."
# @config match_mode select "Value matching" default=boolean options=boolean,exact,any group="Matching"
# @config active_value text "Exact active value" default="true" group="Matching"
# @config inactive_value text "Exact inactive value" default="false" group="Matching"
# @config display_seconds number "Display seconds" default=8 min=2 max=30 group="Display"
# @config alarm_seconds number "Alarm display seconds" default=12 min=2 max=60 group="Display"
# @config cooldown_seconds number "Per-event cooldown seconds" default=3 min=0 max=60 group="Input limits"
# @config queue_seconds number "Pending event lifetime seconds" default=30 min=5 max=300 group="Input limits"
# @config show_labels bool "Show event labels" default=false group="Display"
# @config wake_display bool "Wake display for events" default=false group="Display" help="Calls display.power(true) only when an event starts."

import json
import string

class EventArtwork
  # Original pixel art. Compact mode is composed at 26 pixels, never squeezed.
  # The caller supplies elapsed time; MQTT and rotation stay in EventTrigger.
  var canvas_width, colors, clip_left

  def compact(labels)
    if type(labels) == "bool" return labels end
    return labels != nil && size(labels) > 0 && labels[0] != ""
  end

  def phase(elapsed_ms)
    var value = int(elapsed_ms) % 4000
    return value < 0 ? value + 4000 : value
  end

  def rf(x, y, width, height, color)
    # Clip sprite entrances/exits to the artwork viewport, including label mode.
    var right = min(self.canvas_width, x + width)
    var bottom = min(16, y + height)
    x = max(self.clip_left, x) y = max(0, y)
    if right > x && bottom > y rect_fill(x, y, right - x, bottom - y, color) end
  end

  def px(x, y, color)
    self.rf(x, y, 1, 1, color)
  end

  def ln(x, y, x2, y2, color)
    if x >= 0 && x < self.canvas_width && x2 >= 0 && x2 < self.canvas_width && y >= 0 && y < 16 && y2 >= 0 && y2 < 16
      line(x, y, x2, y2, color)
    end
  end

  def stamp(rows, x, y)
    # Equal-color horizontal runs avoid a native call per sprite pixel.
    for row : 0 .. size(rows) - 1
      var data = rows[row]
      var column = 0
      while column < size(data)
        var ink = data[column]
        var first = column
        while column < size(data) && data[column] == ink column += 1 end
        if ink != "." self.rf(x + first, y + row, column - first, 1, self.colors[ink]) end
      end
    end
  end

  def ease(t, start, finish, first, last)
    var span = finish - start
    var n = int(clamp(t - start, 0, span))
    return first + int((last - first) * n * (2 * span - n) / (span * span))
  end

  def sky()
    self.rf(0, 0, self.canvas_width, 5, 0x080C19)
    self.rf(0, 5, self.canvas_width, 7, 0x10192A)
    self.rf(0, 12, self.canvas_width, 4, 0x1A2733)
  end

  def sparkle(x, y, bright)
    self.px(x, y, bright ? 0xFFF1BD : 0x9A773E)
    if bright
      self.px(x - 1, y, 0xC99546) self.px(x + 1, y, 0xC99546)
      self.px(x, y - 1, 0xC99546) self.px(x, y + 1, 0xC99546)
    end
  end

  def house(x, y)
    self.stamp([
      "........r........", ".......rRr.......", "......rRRRr......",
      ".....rRRRRRr.....", "....rRRRRRRRr....", "...rRRRRRRRRRr...",
      "..rRRRRRRRRRRRr..", ".rrrrrrrrrrrrrrr.", "..hhhhhhhhhhhhh..",
      "..hYYhdddhYYhh..", "..hYyhdddhYyhh..", "..hhhhdddhhhhhh..",
      "..hhhhddDhhhhhh..", "..hhhhdddhhhhhh.."], x, y)
  end

  def walker(x, y, step)
    self.stamp(["..kkk..", "..kss..", "..sSs..", "...s...",
      "..tTt..", ".tTTTt.", ".stTTs.", "..tTt..", "..nnn.."], x, y)
    if step == 0
      self.stamp(["..n.n..", ".nn..n.", ".K...KK"], x, y + 9)
    elif step == 1
      self.stamp(["..nn...", "..n.n..", "..K.KK."], x, y + 9)
    elif step == 2
      self.stamp(["..n.n..", ".n..nn.", "KK...K."], x, y + 9)
    else
      self.stamp(["...nn..", "..n.n..", ".KK.K.."], x, y + 9)
    end
  end

  def motion(t)
    var w = self.canvas_width
    self.sky()
    self.house(w == 52 ? 1 : 7, 0)
    if w == 52
      self.house(35, 1)
      self.px(25, 0, 0xA8BBC2) self.px(27, 1, 0x638294)
      self.px(29, 3, 0x638294) self.px(32, 0, 0x638294)
      self.rf(19, 11, 14, 1, 0x31515A)
      for post : 0 .. 4 self.rf(20 + post * 3, 9, 1, 4, 0x436573) end
    end
    self.rf(0, 14, w, 2, 0x263E40)
    self.rf(0, 15, w, 1, 0x152B2E)
    var x = int(t * (w + 7) / 4000) - 7
    self.rf(x, 14, 9, 1, 0x0A121C)
    self.walker(x, 3, int(t / 140) % 4)
    # A camera LED and fading footsteps identify a detection without obscuring
    # the walker's face or attaching a floating symbol to its silhouette.
    var detected = t >= 800 && t < 3500
    self.rf(w - 5, 2, 4, 2, 0x8A9AA4)
    self.px(w - 5, 3, detected ? 0xFF7355 : 0x48525C)
    if detected
      self.rf(x - 3, 14, 2, 1, 0x71D1BB)
      self.rf(x - 7, 14, 2, 1, 0x427E76)
      self.rf(x - 11, 14, 2, 1, 0x2C5556)
    end
  end

  def envelope(x, y)
    self.stamp(["WWWWWWW", "WYwwwYW", "WwYYYwW", "WwwYwwW", "YYYYYYY"], x, y)
  end

  def mailbox(x, open_door, raised)
    self.stamp([
      "...aaaaaaabbbbb......", "..aAAAAAAAABBBbb.....", ".aAAAaaaaAABBBBbb....",
      "aAAAaAAAAaABBBBbbb...", "aAAAaAAAAaABBBBbbb...", "aAAAaAAAAaABBBBbbb...",
      "aAAAaaaaaaABBBBbbb...", ".aaaaaaaaaabbbbbb...."], x, 3)
    self.rf(x + 9, 11, 3, 4, 0x866A4C)
    self.rf(x + 9, 11, 1, 4, 0xC39A68)
    self.rf(x + 5, 15, 11, 1, 0x33454A)
    if open_door
      self.rf(x + 12, 6, 5, 4, 0x0A1820)
      self.rf(x + 16, 10, 5, 1, 0x8BD0CE)
      self.px(x + 20, 9, 0xD0E4D6)
    else
      self.rf(x + 13, 5, 3, 4, 0x2B7177)
      self.px(x + 15, 7, 0xB6E0D8)
    end
    self.rf(x + 10, raised ? 1 : 5, 1, raised ? 6 : 3, 0xDED1AC)
    self.rf(x + 11, raised ? 1 : 7, 4, 2, 0xD44F53)
    self.rf(x + 11, raised ? 1 : 7, 3, 1, 0xFF8F76)
  end

  def mail_background()
    self.sky()
    self.rf(0, 13, self.canvas_width, 3, 0x182D29)
    for blade : 0 .. int(self.canvas_width / 4) - 1 self.px(blade * 4 + 1, 13, 0x315244) end
    if self.canvas_width == 52
      self.rf(1, 10, 7, 1, 0x3B5353)
      self.rf(2, 8, 1, 5, 0x54716A) self.rf(6, 8, 1, 5, 0x54716A)
      self.px(43, 2, 0x45616F) self.px(48, 5, 0x45616F)
    end
  end

  def mail_received(t)
    self.mail_background()
    var bx = self.canvas_width == 52 ? 17 : 2
    self.mailbox(bx, t < 2700, t >= 2800)
    if t < 2700
      var ex = self.ease(t, 0, 2700, self.canvas_width + 1, bx + 5)
      # Arrival and collection both use the opening on the right. The leading
      # edge disappears behind its lip rather than through the metal side.
      self.clip_left = bx + 12
      self.envelope(ex, 6)
      self.clip_left = 0
    end
    if t >= 2800
      self.sparkle(bx - 3, 5, int(t / 250) % 2 == 0)
      self.sparkle(bx + 23, 3, int(t / 250) % 2 != 0)
    end
  end

  def mail_collected(t)
    self.mail_background()
    var bx = self.canvas_width == 52 ? 10 : 0
    self.mailbox(bx, t >= 400, t < 2000)
    if self.canvas_width == 52
      self.walker(43, 3, 1)
      self.rf(38, 8, 7, 1, 0xF5B38C)
    end
    var ex = self.ease(t, 500, 2600, bx + 12, self.canvas_width == 52 ? 37 : 22)
    if t >= 400 && t < 3100 self.envelope(ex, t > 2200 ? 5 : 6) end
    if t >= 2500 self.sparkle(bx + 6, 1, int(t / 250) % 2 == 0) end
  end

  def bell(x, y, lean)
    self.stamp([
      "......YY.......", ".....YWWY......", "....YOYYOY.....", "...YOYYYYOY....",
      "...YWYYYYOY....", "..YOWYYYYYOY...", "..YOWYYYYYOY...", "..YOWYYYYYOY...",
      ".YOYYYYYYYYOY..", "YWWWWWWWWWWWWY.", ".OOOOOOOOOOOO.."], x + lean, y)
    self.rf(x + 6 - lean, y + 11, 3, 1, 0xE69A37)
    self.px(x + 7 - lean, y + 12, 0xFFE7A0)
  end

  def doorbell(t)
    var w = self.canvas_width
    self.sky()
    if w == 52
      self.rf(1, 2, 12, 13, 0x735345)
      self.rf(3, 3, 8, 12, 0x2C313D)
      self.rf(4, 4, 6, 5, 0xD89850)
      self.rf(5, 5, 4, 3, 0xFFE0A0)
      self.rf(4, 10, 6, 4, 0x443D3B)
      self.px(9, 10, 0xE8C98D)
      self.rf(0, 1, 14, 1, 0xC18D62)
      self.rf(0, 15, 15, 1, 0x997455)
    end
    var bx = w == 52 ? 26 : 6
    var beat = int(t / 120) % 8
    var lean = (beat == 1 || beat == 2) ? 1 : ((beat == 5 || beat == 6) ? -1 : 0)
    self.rf(bx - 3, 14, 21, 1, 0x34342D)
    self.bell(bx, 1, lean)
    var ring = int(t / 160) % 5
    for arc : 0 .. 2
      if ring > arc
        var c = arc == 0 ? 0xFFE7A0 : (arc == 1 ? 0xE9B44D : 0x96703B)
        var left = bx - 2 - arc * 3
        var right = bx + 16 + arc * 3
        self.ln(left, 4, left - 1, 7, c) self.ln(left - 1, 7, left, 10, c)
        self.ln(right, 4, right + 1, 7, c) self.ln(right + 1, 7, right, 10, c)
      end
    end
  end

  def heat(t)
    var w = self.canvas_width
    self.rf(0, 0, w, 5, 0x190D1C)
    self.rf(0, 5, w, 6, 0x32151E)
    self.rf(0, 11, w, 5, 0x57221E)
    var x = w == 52 ? 8 : 0
    var sway = int(t / 140) % 4
    self.stamp(sway < 2 ? [
      "........o.........", ".......oY.........", ".......oYo........",
      "...o...oYYo.......", "..oYo.oYYYyo......", "..oYYooYYYyo..o...",
      ".oYYYYYYYYYYooYo..", ".oYYYYYYYYYYYYYYo.", "oYYYYYYYYYYYYYYYyo",
      "oYYYYYWYYYYYYYYYyo", "oyYYYWWWYYYYYYYyyo", ".oyYWWWWWYYYYYyyo.",
      "..oyWWWWWYYYYyyo..", "...oYYYYYYYYyyo..."] : [
      ".........o........", "........oYo.......", "...o....oYo.......",
      "...Yo..oYYo.......", "..oYYo.oYYYo......", "..oYYYooYYYYo.....",
      ".oYYYYYYYYYYYo.o..", ".oYYYYYYYYYYYYoYo.", "oYYYYYYYYYYYYYYYyo",
      "oYYYYYYYYYYYYYYYyo", "oyYYYYWWYYYYYYYyyo", ".oyYYWWWWYYYYYyyo.",
      "..oyWWWWWYYYYyyo..", "...oYYYYYYYYyyo..."], x, 0)
    self.rf(0, 14, w, 2, 0x8A3928)
    for ember : 0 .. int(w / 3) - 1
      self.px(ember * 3 + (int(t / 200) % 2), 14, ember % 2 == 0 ? 0xF5A346 : 0xC85C32)
    end
    if w == 52
      self.stamp(["..HHH..", ".HLLLH.", ".HLdLH.", ".HLdLH.", ".HLdLH.",
        ".HLdLH.", ".HLdLH.", ".HLdLH.", "HLdddLH", "HLdddLH", "HLdddLH", ".HLLLH.", "..HHH.."], 34, 1)
      var level = 3 + int(t / 250) % 5
      self.rf(37, 10 - level, 1, level + 1, 0xF96A55)
      self.rf(36, 10, 3, 2, 0xFF7857)
      self.px(36, 10, 0xFFD39A)
      self.rf(46, 3, 2, 5, 0xF96A55)
      self.rf(46, 10, 2, 2, int(t / 250) % 2 == 0 ? 0xFFF1BD : 0xA84538)
      self.rf(0, 0, 2, 2, 0xC95940) self.rf(50, 0, 2, 2, 0xC95940)
    end
    for ember : 0 .. 2
      var rise = (int(t / 120) + ember * 4) % 12
      self.px(x + 2 + ember * 6, 12 - rise, rise % 3 == 0 ? 0xFFD787 : 0xB95435)
    end
  end

  def droplet(x, y)
    self.stamp(["....c....", "...cCc...", "...cWCc..", "..cWCCCc.",
      ".cWWCCCcb", ".cWCCCCcb", "cWCCCCCCb", "cCCCCCCCb", ".cCCCCCbb", "..ccbbbb."], x, y)
  end

  def water(t)
    var w = self.canvas_width
    self.rf(0, 0, w, 5, 0x0A1520)
    self.rf(0, 5, w, 8, 0x102A36)
    self.rf(0, 13, w, 3, 0x174355)
    var pipe = w == 52 ? 3 : 0
    self.rf(pipe, 2, 19, 4, 0x666666)
    self.rf(pipe, 2, 19, 1, 0xB5B5B5)
    self.rf(pipe, 3, 19, 1, 0x929292)
    self.rf(pipe + 1, 1, 2, 6, 0xC1C1C1)
    self.rf(pipe + 12, 1, 2, 6, 0xC1C1C1)
    self.rf(pipe + 16, 4, 4, 4, 0x888888)
    self.rf(pipe + 17, 4, 1, 3, 0xD0D0D0)
    self.rf(pipe + 16, 7, 4, 1, 0x4EAFCA)
    var drop = int(t / 100) % 12
    if drop < 6
      self.px(pipe + 18, 8 + drop, 0xB3F5F5)
      self.px(pipe + 17, 7 + drop, 0x46ADC5)
    end
    if w == 52
      self.droplet(34, 2 + (int(t / 500) % 2))
      self.px(29, 5, 0x2E687C) self.px(46, 9, 0x2E687C)
    end
    var swell = int(t / 160) % 6
    for wave : 0 .. int(w / 8)
      var wx = wave * 8 + swell - 4
      self.rf(wx, 13, 5, 1, 0x3D9BB5)
      self.rf(wx + 2, 14, 4, 1, 0x79D4DD)
      self.rf(wx - 1, 15, 4, 1, 0x215E79)
    end
    if drop >= 6 && drop <= 9
      var radius = drop - 5
      self.px(pipe + 18 - radius, 12, 0xB3F5F5)
      self.px(pipe + 18 + radius, 12, 0xB3F5F5)
    end
  end

  def garage(t)
    var w = self.canvas_width
    var left = w == 52 ? 5 : 0
    var width = w == 52 ? 40 : 26
    self.sky()
    self.rf(left, 2, width, 13, 0x846B63)
    self.rf(left + 1, 3, width - 2, 12, 0xB59A80)
    self.rf(left + 3, 4, width - 6, 10, 0x151E2D)
    self.rf(left - 2, 0, width + 4, 2, 0x5A3440)
    self.rf(left - 1, 1, width + 2, 1, 0xAC7263)
    self.rf(left, 15, width, 1, 0x35434F)
    var cx = left + int(width / 2) - 9
    self.stamp(["....LLLLLLL......", "...LaCCCCCaL.....", "..LaCCCCCCCaL....",
      ".rrrrrrrrrrrrr...", "rYYYYrrrrYYYYrr..", "rWWWWrrrrWWWWrr..", ".krrrkkkkrrrk...."], cx, 8)
    var bottom = self.ease(t, 200, 2200, 14, 4)
    self.rf(left + 3, 4, width - 6, bottom - 3, 0x777C83)
    for row : 4 .. bottom
      if row % 3 == 1 self.rf(left + 3, row, width - 6, 1, 0xB8BEC2) end
      if row % 3 == 0 self.rf(left + 3, row, width - 6, 1, 0x4E5863) end
    end
    self.rf(left + 3, bottom, width - 6, 1, 0xCDD1CC)
    self.rf(left + int(width / 2) - 2, bottom, 4, 1, 0x414A55)
    if t > 1700
      self.rf(cx + 2, 15, 3, 1, 0x796A49) self.rf(cx + 10, 15, 3, 1, 0x796A49)
    end
    if w == 52
      var rise = int(t / 240) % 3
      self.ln(48, 8 - rise, 49, 7 - rise, 0x7BD4B6)
      self.ln(49, 7 - rise, 50, 8 - rise, 0x7BD4B6)
      self.rf(1, 5, 2, 2, 0xF3C079) self.rf(46, 5, 2, 2, 0xF3C079)
    end
  end

  # Appliance scenes use the same shaded sprites and dark room depth as the
  # outdoor scenes. Each four-second loop reveals the finished contents, then
  # holds them still; only highlights continue during that resting beat.
  def room(kitchen)
    self.sky()
    var w = self.canvas_width
    self.rf(0, 5, w, 8, kitchen ? 0x182A32 : 0x142B36)
    self.rf(0, 13, w, 3, 0x263C40)
    self.rf(0, 15, w, 1, 0x102027)
    if w == 52
      self.rf(0, 5, w, 1, 0x243D43)
      for tile : 0 .. 6 self.rf(tile * 8 + 2, 6, 1, 6, 0x1E333B) end
      if kitchen
        self.rf(1, 2, 7, 10, 0x51463F)
        self.rf(2, 3, 5, 8, 0x806B55)
        self.rf(3, 4, 3, 6, 0x6B5849)
        self.px(6, 7, 0xD8BA84)
      else
        self.rf(34, 2, 16, 1, 0x6C7167)
        self.rf(35, 1, 1, 3, 0xBDBA9E)
        self.rf(48, 1, 1, 3, 0xBDBA9E)
      end
    end
  end

  def dish_plate(x, y)
    self.stamp([".LL.", "LWWL", "LwwL", "LwwL", "LWWL", ".LL."], x, y)
  end

  def dishwasher_finished(t)
    self.room(true)
    var wide = self.canvas_width == 52
    var x = wide ? 12 : 2
    # A stone worktop, pale front and receding teal side form one cabinet.
    self.stamp(["LLLLLLLLLLLLLLLLLLLLL", "HWWWWWWWWWWWWWWWWWHbb",
      "HLLLkkkkkkkkkkLLLHHbb", "HLkkkkkkkkkkkkkkkHHbb",
      "HLkkkkkkkkkkkkkkkHHbb", "HLkkkkkkkkkkkkkkkHHbb",
      "HLkkkkkkkkkkkkkkkHHbb", "HLkkkkkkkkkkkkkkkHHbb",
      "HLkkkkkkkkkkkkkkkHHbb", "HLkkkkkkkkkkkkkkkHHbb",
      "HLkkkkkkkkkkkkkkkHHbb", "HHHHHHHHHHHHHHHHHHHbb",
      ".kkkkkkkkkkkkkkkkkk.."], x, 2)
    self.px(x + 15, 4, t < 600 ? 0xE3973D : 0x7BD4B6)
    var rack_y = self.ease(t, 500, 1700, 6, 7)
    for plate : 0 .. 2 self.dish_plate(x + 3 + plate * 5, rack_y) end
    self.rf(x + 2, rack_y + 5, 15, 1, 0x74A6A8)
    for wire : 0 .. 4 self.px(x + 3 + wire * 3, rack_y + 6, 0xB5C5BB) end
    # The front folds down to a shallow tray, revealing the rack progressively.
    var top = self.ease(t, 200, 1500, 5, 13)
    self.rf(x + 1, top, 17, 14 - top, 0x7A9294)
    self.rf(x + 1, top, 17, 1, 0xD3DDD1)
    self.rf(x + 3, top + 1, 13, 1, 0x465C64)
    if t >= 1700
      self.sparkle(x + 4, 7, int(t / 300) % 3 == 0)
      self.sparkle(x + 13, 9, int(t / 300) % 3 == 1)
    end
    if wide
      # Sink and clean plate stack complete the miniature kitchen.
      self.rf(35, 11, 15, 2, 0x8B806B)
      self.rf(35, 11, 15, 1, 0xD1B58A)
      self.rf(38, 11, 7, 1, 0x34515A)
      self.ln(41, 10, 41, 6, 0x9AAEAD)
      self.ln(41, 6, 44, 6, 0xC4D2C8)
      self.px(44, 7, 0x9AAEAD)
      self.rf(36, 14, 13, 1, 0x6F604D)
      self.rf(36, 13, 1, 2, 0x9F8866)
      self.rf(48, 13, 1, 2, 0x9F8866)
      self.stamp([".WWWWW.", "LwwwwwL", ".LLLLL."], 44, 8)
    end
  end

  def fryer_body(x, y)
    self.stamp(["....HHHHHHHH......", "..HHLLLLLLLLHH....",
      ".HLLLLLLLLLLLLHb..", "HLLLkkkkkkkkLLHbb.",
      "HLLkTTkTTkkkLLHbb.", "HLLLkkkkkkkkLLHbb.",
      "HLLkkkkkkkkkLLHbb.", "HLLkkkkkkkkkLLHbb.",
      "HLLkkkkkkkkkLLHbb.", "HLLkkkkkkkkkLLHbb.",
      "HLLkkkkkkkkkLLHbb.", ".HHHHHHHHHHHHHHbb.",
      "..kk........kk...."], x, y)
  end

  def food_basket(x, y)
    self.stamp(["..OOOOOOOOOO...", ".OYYYYYYYYYYO..",
      "OYYyYoyYoyYYYOO", "OWWWWWWWWWWWWO.",
      ".OAAAAAAAAAAOb.", ".OAAAkkkkAAAOb.",
      "..OOOkkkkOOOb.."], x, y)
    self.rf(x + 6, y + 4, 4, 1, 0x7B9294)
  end

  def cooker_finished(t)
    self.room(true)
    var wide = self.canvas_width == 52
    var x = wide ? 12 : 1
    self.rf(0, 14, self.canvas_width, 1, 0xB19168)
    self.rf(0, 15, self.canvas_width, 1, 0x57453B)
    self.fryer_body(x, 1)
    self.px(x + 10, 5, t < 500 ? 0xE3973D : 0x7BD4B6)
    # The drawer eases out once, then the food rests in its open basket.
    var slide = self.ease(t, 200, 1700, 0, wide ? 8 : 5)
    var bx = x + 1 + slide
    self.food_basket(bx, 7)
    if t > 900 && t < 2600
      var rise = int((t - 900) / 220)
      var sy = 6 - (rise % 4)
      var ink = t < 1800 ? 0xD6C6A4 : 0x7B887E
      self.px(bx + 4, sy, ink)
      self.px(bx + 5, sy - 1, ink)
      if t < 2000 self.px(bx + 9, sy - 1, ink) end
    end
    if t >= 2000 self.sparkle(bx + 10, 7, int(t / 300) % 3 == 0) end
    if wide
      # A plate, napkin and fork give the food a serving context.
      self.stamp(["..LLLLLLLL..", ".LWWWWWWWWL.", "LWWYYYYYYWWL",
        ".LWWWWWWWWL.", "..LLLLLLLL.."], 38, 9)
      self.rf(36, 10, 1, 4, 0xB7C6BE)
      self.rf(35, 9, 1, 2, 0xB7C6BE)
      self.rf(37, 9, 1, 2, 0xB7C6BE)
      self.rf(45, 5, 4, 2, 0x47999B)
      self.rf(46, 4, 2, 1, 0x7DBDB7)
    end
  end

  def laundry_body(x, warm)
    self.stamp([".HHHHHHHHHHHHHHHH...", "HLLLLLLLLLLLLLLLHHbb",
      "HLHHHHHHHHHHHHHLHHbb", "HLLkkkkkkkkkLLHLHHbb",
      "HLLLkkkkkkkLLLHLHHbb", "HLLkkAAAAAkkLLHLHHbb",
      "HLkAAkkkkkAAkLHLHHbb", "HLkAkkkkkkkAkLHLHHbb",
      "HLkAkkkkkkkAkLHLHHbb", "HLkAkkkkkkkAkLHLHHbb",
      "HLkAAkkkkkAAkLHLHHbb", "HLLkkAAAAAkkLLHLHHbb",
      "HLLLLLLLLLLLLLLLHHbb", ".HHHHHHHHHHHHHHHHbbb",
      "..kk.........kk....."], x, 1)
    self.rf(x + 3, 3, 3, 1, warm ? 0xD5A364 : 0x47999B)
    self.rf(x + 10, 3, 2, 1, 0x728D8C)
    self.px(x + 14, 3, 0x7BD4B6)
    # The door opening remains round and the laundry is stationary inside.
    self.stamp(warm ? [".YYYY..", "YWWYYy.", "YWWYYy.", ".YYYy.."] :
      [".rrr...", "rRRrTT.", "rRRrTT.", ".rrTT.."], x + 5, 8)
  end

  def laundry_door(x, t, right)
    var opening = self.ease(t, 200, 1300, 0, 3)
    var dx = right ? 3 : -3
    if opening == 0
      self.stamp(["..HHHHH..", ".HLLLLLH.", "HLbCCCbbH", "HLCCcCbbH",
        "HLCCcCbbH", "HLbCCbbbH", ".HLLLLLH.", "..HHHHH.."], x + 4, 5)
    elif opening == 1
      self.stamp([".HHHHH.", "HLLLLLH", "HLCCbbH", "HLCCbbH",
        "HLCCbbH", "HLCCbbH", "HLLLLLH", ".HHHHH."], x + 4 + dx, 5)
    else
      self.stamp(opening == 2 ? [".HHH.", "HLLLH", "HLbbH", "HLbbH",
        "HLbbH", "HLbbH", "HLLLH", ".HHH."] :
        [".HH", "HLH", "HbH", "HbH", "HbH", "HbH", "HLH", ".HH"],
        right ? x + 13 : x + 1, 5)
    end
  end

  def laundry_basket(x, y)
    self.stamp(["WW..TTT..WW", "WwWTtTTWwWW", ".OOOOOOOOO.",
      ".OYYYYYYYO.", "..OYOYOYO..", "..OOOOOOO.."], x, y)
  end

  def washing_machine_finished(t)
    self.room(false)
    var wide = self.canvas_width == 52
    var x = wide ? 10 : 2
    self.laundry_body(x, false)
    self.laundry_door(x, t, false)
    if wide
      self.laundry_basket(37, 10)
      self.stamp([".WWWWW.", "WWWWWWW", "W.WWW.W", "..WWW..", "..WWW.."], 37, 3)
      if t >= 1500 && t < 2900
        var sx = self.ease(t, 1500, 2900, x + 6, 40)
        var sy = t < 2150 ? self.ease(t, 1500, 2150, 8, 5) : self.ease(t, 2150, 2900, 5, 10)
        self.stamp([".rrr.", "rRRRr", "r.R.r", ".RRR.", ".rrr."], sx, sy)
      elif t >= 2900
        self.stamp([".rrr.", "rRRRr", ".RRR."], 40, 9)
      end
    end
    if t >= 1800 self.sparkle(x + 10, 6, int(t / 350) % 3 == 0) end
    self.px(x + 14, 3, t < 500 ? 0xE3973D : 0x7BD4B6)
  end

  def folded_towels(x, y)
    self.stamp([".WWWWWWWW..", "WwwwwwwwwW.", ".YYYYYYYY..",
      "..TTTTTTTT.", ".TtttttttT.", "..AAAAAAA.."], x, y)
  end

  def dryer_finished(t)
    self.room(false)
    var wide = self.canvas_width == 52
    var x = wide ? 10 : 2
    self.laundry_body(x, true)
    self.laundry_door(x, t, true)
    if wide
      self.folded_towels(38, 9)
      self.rf(35, 15, 16, 1, 0x8A7256)
      if t >= 1400 && t < 2900
        var tx = self.ease(t, 1400, 2900, x + 6, 39)
        var ty = t < 2150 ? 7 : self.ease(t, 2150, 2900, 7, 8)
        self.stamp(["WWWWWWW", "WwwwwwW", "WwwwwwW", ".YYYYY."], tx, ty)
      elif t >= 2900
        self.stamp([".WWWWWWWW.", "WwwwwwwwwW", ".YYYYYYYY."], 38, 7)
      end
    end
    # Remaining warm air dissipates after opening; towels no longer tumble.
    if t > 500 && t < 2100
      var rise = int((t - 500) / 220) % 3
      self.px(x + 9, 4 - rise, 0xD6BB88)
      self.px(x + 10, 3 - rise, 0x8C876E)
    end
    if t >= 1800 self.sparkle(x + 7, 9, int(t / 350) % 3 == 1) end
    self.px(x + 14, 3, t < 500 ? 0xE3973D : 0x7BD4B6)
  end

  def quiet(t)
    self.sky()
    var x = int(self.canvas_width / 2)
    self.rf(x - 5, 6, 11, 5, 0x263D4B)
    self.rf(x - 3, 4, 7, 1, 0x4C7880)
    self.rf(x - 1, 2, 3, 1, int(t / 500) % 2 == 0 ? 0x82C9B4 : 0x426C68)
    self.px(x, 8, 0x82C9B4)
  end

  def draw_labels(scene)
    var upper = ["MOVE", "NEW", "MAIL", "HEAT", "WATER", "DING", "OPEN", "DISH", "COOK", "WASH", "DRY"]
    var lower = ["FRONT", "MAIL", "PICKUP", "ALARM", "LEAK", "DONG", "GARAGE", "DONE", "DONE", "DONE", "DONE"]
    var ink = [0x82C9B4, 0xF6D28A, 0x82C9B4, 0xFF9670, 0x7BDAE3, 0xF6D28A, 0x82C9B4,
      0x8BE6A5, 0xF6B06A, 0x7BDAE3, 0xF0BD70]
    text(28, 6, scene < 0 ? "IDLE" : upper[scene], scene < 0 ? 0x82C9B4 : ink[scene])
    text(28, 14, scene < 0 ? "READY" : lower[scene], 0xA6A6A6)
  end

  def paint(scene, elapsed_ms, labels)
    clear() font("small")
    self.canvas_width = self.compact(labels) ? 26 : 52
    self.clip_left = 0
    if self.colors == nil
      self.colors = {"r":0xA94E54, "R":0xCA6B62, "h":0xBEA186, "d":0x3C3944, "D":0xDBBA81,
        "Y":0xFFD16F, "y":0xE3973D, "W":0xFFF1C5, "w":0xE6CB91, "O":0xAA642E, "o":0xE86736,
        "k":0x172331, "K":0xD8B588, "s":0xD39B7A, "S":0xFFD2A1, "t":0x267A78, "T":0x7BD4B6,
        "n":0x38516C, "a":0x7DBDB7, "A":0x47999B, "b":0x26495C, "B":0x326A7A,
        "H":0x9E9E9E, "L":0xDBDBDB, "c":0x4CAEC5, "C":0x74D7E2}
    end
    var t = self.phase(elapsed_ms)
    if scene == 0 self.motion(t)
    elif scene == 1 self.mail_received(t)
    elif scene == 2 self.mail_collected(t)
    elif scene == 3 self.heat(t)
    elif scene == 4 self.water(t)
    elif scene == 5 self.doorbell(t)
    elif scene == 6 self.garage(t)
    elif scene == 7 self.dishwasher_finished(t)
    elif scene == 8 self.cooker_finished(t)
    elif scene == 9 self.washing_machine_finished(t)
    elif scene == 10 self.dryer_finished(t)
    else self.quiet(t)
    end
    if self.compact(labels) self.draw_labels(scene >= 0 && scene <= 10 ? scene : -1) end
  end
end

class EventTrigger : EventArtwork
  var topic, event_mode, trigger_mode, payload_field, match_mode
  var active_value, inactive_value
  var display_ms, alarm_ms, cooldown_ms, queue_ms
  var show_labels, wake_display
  var names
  var pending, edge_active, last_accepted, failed, rejection_logged
  var recent_ids, sequence
  var current_scene, current_started, current_priority, current_duration_ms
  var request_scene, show_requested, cancelled_request, shown, manual_idle
  var idle_started

  def init()
    self.names = ["motion", "mail_received", "mail_collected", "heat", "water", "doorbell", "garage",
      "dishwasher_finished", "cooker_finished", "washing_machine_finished", "dryer_finished"]
    self.topic = store.get("topic", "homey/events/+")
    if type(self.topic) != "string" self.topic = "homey/events/+" end
    self.event_mode = string.tolower(str(store.get("event_mode", "auto")))
    if self.event_mode != "auto" && self.scene_index(self.event_mode) < 0
      self.event_mode = "auto"
    end
    self.trigger_mode = string.tolower(str(store.get("trigger_mode", "pulse")))
    if self.trigger_mode != "edge" self.trigger_mode = "pulse" end
    self.payload_field = store.get("payload_field", "")
    if type(self.payload_field) != "string" self.payload_field = "" end
    self.match_mode = string.tolower(str(store.get("match_mode", "boolean")))
    if self.match_mode != "exact" && self.match_mode != "any" self.match_mode = "boolean" end
    self.active_value = self.clean_setting(store.get("active_value", "true"), "true")
    self.inactive_value = self.clean_setting(store.get("inactive_value", "false"), "false")
    self.display_ms = int(clamp(num(store.get("display_seconds"), 8), 2, 30)) * 1000
    self.alarm_ms = int(clamp(num(store.get("alarm_seconds"), 12), 2, 60)) * 1000
    self.cooldown_ms = int(clamp(num(store.get("cooldown_seconds"), 3), 0, 60)) * 1000
    self.queue_ms = int(clamp(num(store.get("queue_seconds"), 30), 5, 300)) * 1000
    self.show_labels = store.get("show_labels", false) == true
    self.wake_display = store.get("wake_display", false) == true

    self.pending = []
    self.edge_active = []
    self.last_accepted = []
    self.failed = []
    self.rejection_logged = []
    for scene : 0 .. size(self.names) - 1
      self.pending.push(nil)
      self.edge_active.push(false)
      self.last_accepted.push(nil)
      self.failed.push(false)
      self.rejection_logged.push(false)
    end
    self.recent_ids = []
    self.sequence = 0
    self.current_scene = -1
    self.current_started = nil
    self.current_priority = 0
    self.current_duration_ms = self.display_ms
    self.request_scene = -1
    self.show_requested = false
    self.cancelled_request = false
    self.shown = false
    self.manual_idle = false
    self.idle_started = now_ms()
  end

  def setup()
    if self.topic == ""
      log("EventTrigger: empty MQTT topic filter; input disabled")
      return
    end
    mqtt.subscribe(self.topic, / topic, payload -> self.receive(topic, payload))
  end

  def clean_setting(value, fallback)
    if type(value) != "string" return fallback end
    var result = self.trim(value)
    return size(result) > 0 ? result : fallback
  end

  def trim(value)
    if type(value) != "string" return "" end
    var first = 0
    var last = size(value) - 1
    while first <= last && (value[first] == " " || value[first] == "\n" || value[first] == "\r" || value[first] == "\t")
      first += 1
    end
    while last >= first && (value[last] == " " || value[last] == "\n" || value[last] == "\r" || value[last] == "\t")
      last -= 1
    end
    return first > last ? "" : value[first .. last]
  end

  def scene_index(value)
    if type(value) != "string" return -1 end
    var candidate = string.tolower(self.trim(value))
    for index : 0 .. size(self.names) - 1
      if candidate == self.names[index] return index end
    end
    return -1
  end

  def topic_scene(topic)
    if type(topic) != "string" || size(topic) == 0 return -1 end
    var slash = -1
    for index : 0 .. size(topic) - 1
      if topic[index] == "/" slash = index end
    end
    if slash < 0 || slash >= size(topic) - 1 return -1 end
    return self.scene_index(topic[slash + 1 .. size(topic) - 1])
  end

  def has_key(body, key)
    if !isinstance(body, map) return false end
    for existing : body.keys()
      if existing == key return true end
    end
    return false
  end

  def parse_payload(payload)
    if type(payload) == "string"
      if size(payload) > 512 return nil end
      var raw = self.trim(payload)
      if raw == "" return nil end
      if raw == "null" return nil end
      var parsed = nil
      try
        parsed = json.load(raw)
      except ..
        parsed = nil
      end
      if parsed != nil return parsed end
      try
        # JSON false and zero are valid parsed scalars, while Berry's JSON
        # helper may answer nil for a plain unquoted MQTT string.
        parsed = json.load(raw)
        if type(parsed) == "bool" || type(parsed) == "int" || type(parsed) == "real"
          return parsed
        end
      except ..
        parsed = nil
      end
      if parsed == nil
        # Plain MQTT scalar strings are useful for boolean and event-name flows.
        # JSON-shaped input that failed to parse remains invalid, rather than being
        # silently interpreted as an event.
        if raw[0] == "{" || raw[0] == "[" || raw[0] == "\"" || raw[0] == "'"
          return nil
        end
        return raw
      end
      return parsed
    end
    if type(payload) == "bool" || type(payload) == "int" || type(payload) == "real"
      return payload
    end
    if isinstance(payload, map) return payload end
    return nil
  end

  def boolean_state(value)
    if type(value) == "bool" return value ? 1 : 0 end
    if type(value) == "int" || type(value) == "real"
      if value == 1 return 1 end
      if value == 0 return 0 end
      return -1
    end
    if type(value) != "string" return -1 end
    var candidate = string.tolower(self.trim(value))
    if candidate == "true" || candidate == "1" || candidate == "yes" || candidate == "on" || candidate == "✓" || candidate == "✔" || candidate == "✅"
      return 1
    end
    if candidate == "false" || candidate == "0" || candidate == "no" || candidate == "off" || candidate == "x" || candidate == "×" || candidate == "✕" || candidate == "✖" || candidate == "✗" || candidate == "✘" || candidate == "❌"
      return 0
    end
    return -1
  end

  def text_value(value)
    if type(value) == "string" return self.trim(value) end
    if type(value) == "bool" return value ? "true" : "false" end
    if type(value) == "int" || type(value) == "real" return str(value) end
    return nil
  end

  def exact_state(value)
    var candidate = self.text_value(value)
    if candidate == nil || candidate == "" return -1 end
    candidate = string.tolower(candidate)
    var active = string.tolower(self.trim(self.active_value))
    var inactive = string.tolower(self.trim(self.inactive_value))
    if candidate == active return 1 end
    if candidate == inactive return 0 end
    return -1
  end

  def any_state(value, present)
    if !present return 1 end
    if type(value) == "string" && self.trim(value) == "" return -1 end
    if value == nil || isinstance(value, map) || isinstance(value, list) return -1 end
    var bool_state = self.boolean_state(value)
    if bool_state == 0 return 0 end
    if bool_state == 1 return 1 end
    return 1
  end

  def matched_state(value, present)
    if self.match_mode == "any" return self.any_state(value, present) end
    if !present return -1 end
    if self.match_mode == "exact" return self.exact_state(value) end
    return self.boolean_state(value)
  end

  def parse_event(topic, payload)
    var body = self.parse_payload(payload)
    if body == nil return nil end
    if isinstance(body, list) return nil end
    if isinstance(body, map) && size(body) == 0 && self.match_mode == "any" return nil end

    var explicit_scene = -1
    var explicit_event = false
    if isinstance(body, map) && self.has_key(body, "event")
      explicit_event = true
      var event_value = body.find("event")
      if type(event_value) != "string" return nil end
      explicit_scene = self.scene_index(event_value)
      # An invalid explicit event is never guessed from the topic.
      if explicit_scene < 0 return nil end
    end

    var scene = -1
    if self.event_mode == "auto"
      scene = explicit_scene >= 0 ? explicit_scene : self.topic_scene(topic)
    else
      scene = self.scene_index(self.event_mode)
    end

    # A bare canonical event name is a pulse in auto mode, independent of the
    # configured boolean matcher. It is intentionally not a scene guess for
    # arbitrary values or unknown topics.
    if self.event_mode == "auto" && !explicit_event && type(body) == "string" && size(self.payload_field) == 0
      var bare_scene = self.scene_index(body)
      if bare_scene >= 0
        return {"scene": bare_scene, "state": 1, "id": nil}
      end
    end
    if scene < 0 return nil end

    var present = true
    var activity = body
    if isinstance(body, map)
      present = false
      if size(self.payload_field) > 0
        if self.has_key(body, self.payload_field)
          present = true
          activity = body.find(self.payload_field)
        end
      elif self.has_key(body, "active")
        present = true
        activity = body.find("active")
      elif self.has_key(body, "value")
        present = true
        activity = body.find("value")
      end
    elif size(self.payload_field) > 0
      present = false
    end

    if size(self.payload_field) > 0 && !present return nil end
    var state = self.matched_state(activity, present)
    if state < 0 return nil end

    var event_id = nil
    if state == 1 && isinstance(body, map) && self.has_key(body, "id")
      event_id = body.find("id")
      if type(event_id) != "string" || size(event_id) > 64 return nil end
      if size(event_id) == 0 event_id = nil end
    end
    return {"scene": scene, "state": state, "id": event_id}
  end

  def elapsed(stamp)
    if stamp == nil return 0 end
    return (now_ms() - stamp) & 0x7FFFFFFF
  end

  def id_key(scene, event_id)
    return str(scene) + "/" + event_id
  end

  def id_seen(scene, event_id)
    if event_id == nil return false end
    var key = self.id_key(scene, event_id)
    for recent : self.recent_ids
      if recent == key return true end
    end
    return false
  end

  def remember_id(scene, event_id)
    if event_id == nil return end
    if size(self.recent_ids) >= 16 self.recent_ids.remove(0) end
    self.recent_ids.push(self.id_key(scene, event_id))
  end

  def priority(scene)
    if scene == 3 || scene == 4 return 3 end
    if scene == 5 return 2 end
    return 1
  end

  def expire()
    for scene : 0 .. size(self.names) - 1
      var item = self.pending[scene]
      if item != nil && self.elapsed(item.find("stamp")) >= self.queue_ms
        self.pending[scene] = nil
        if self.request_scene == scene
          self.request_scene = -1
          self.show_requested = false
          self.cancelled_request = true
        end
      end
    end
    # A deferred rotation request must not hold an expired event forever.
    if self.request_scene >= 0 && self.pending[self.request_scene] == nil
      self.request_scene = -1
      self.show_requested = false
      self.cancelled_request = true
    end
  end

  def choose_pending()
    var best = -1
    var best_priority = -1
    var best_order = 0
    for scene : 0 .. size(self.names) - 1
      var item = self.pending[scene]
      if item != nil && !self.failed[scene]
        var item_priority = item.find("priority")
        var item_order = item.find("order")
        if best < 0 || item_priority > best_priority || (item_priority == best_priority && item_order < best_order)
          best = scene
          best_priority = item_priority
          best_order = item_order
        end
      end
    end
    return best
  end

  def request_show()
    self.expire()
    if self.shown || self.show_requested return end
    var scene = self.choose_pending()
    if scene < 0 return end
    self.request_scene = scene
    self.show_requested = true
    self.cancelled_request = false
    var result = nil
    var rejected = false
    try
      result = rotation.show()
    except ..
      rejected = true
    end
    if result == false || rejected
      # A synchronous mock/device may call on_show before returning. In that
      # case the request was already fulfilled and must not be discarded.
      if !self.shown && self.pending[scene] != nil
        self.pending[scene] = nil
        self.request_scene = -1
        self.show_requested = false
          self.cancelled_request = true
        self.failed[scene] = true
        if !self.rejection_logged[scene]
          log("EventTrigger: rotation.show rejected " + self.names[scene])
          self.rejection_logged[scene] = true
        end
      end
    end
  end

  def accept(scene, event_id)
    var now = now_ms()
    if event_id != nil && self.id_seen(scene, event_id) return end
    if self.last_accepted[scene] != nil && self.cooldown_ms > 0 && self.elapsed(self.last_accepted[scene]) < self.cooldown_ms
      return
    end
    if event_id != nil self.remember_id(scene, event_id) end
    self.last_accepted[scene] = now
    self.failed[scene] = false
    self.rejection_logged[scene] = false
    var item = self.pending[scene]
    if item == nil
      self.sequence += 1
      self.pending[scene] = {"stamp": now, "order": self.sequence, "priority": self.priority(scene)}
    else
      # Coalesce a repeated pending pulse while refreshing its finite lifetime;
      # its original order remains the FIFO position within this priority.
      item["stamp"] = now
    end
    if !self.shown self.request_show() end
  end

  def clear_scene(scene)
    if scene < 0 || scene >= size(self.names) return end
    self.edge_active[scene] = false
    self.pending[scene] = nil
    if self.request_scene == scene
      self.request_scene = -1
      self.show_requested = false
      self.cancelled_request = true
    end
    if self.current_scene == scene
      if self.shown
        self.current_scene = -1
        self.current_started = nil
        self.current_priority = 0
        self.current_duration_ms = self.display_ms
        rotation.next()
      else
        self.current_scene = -1
        self.current_started = nil
      end
    end
  end

  def receive(topic, payload)
    self.expire()
    var parsed = self.parse_event(topic, payload)
    if parsed == nil return end
    var scene = parsed.find("scene")
    var state = parsed.find("state")
    if state == 0
      self.clear_scene(scene)
      return
    end
    if state != 1 return end
    var event_id = parsed.find("id")
    # Reject a late duplicate before changing edge state. A duplicate that
    # arrives after a false rearm must not latch the edge again.
    if event_id != nil && self.id_seen(scene, event_id) return end
    if self.trigger_mode == "edge"
      if self.edge_active[scene] return end
      self.edge_active[scene] = true
    end
    self.accept(scene, event_id)
  end

  def should_show()
    self.expire()
    if self.shown return true end
    if self.current_scene >= 0 return true end
    return self.choose_pending() >= 0
  end

  def on_show()
    var was_requested = self.show_requested
    var was_cancelled = self.cancelled_request
    self.expire()
    if self.shown return end
    # A deferred show can receive additional events before the firmware calls
    # on_show(). Re-evaluate priority at that boundary so the highest-priority
    # pending scene gets the turn; the request itself remains single-shot.
    var scene = self.choose_pending()
    if scene < 0 && (was_requested || was_cancelled)
      # The event that summoned this turn expired or was cleared before the
      # deferred callback arrived. Do not turn that stale request into a quiet
      # blank rotation turn; leave immediately and wait for a fresh event.
      self.show_requested = false
      self.request_scene = -1
      self.cancelled_request = false
      rotation.next()
      return
    end
    self.show_requested = false
    self.request_scene = -1
    self.cancelled_request = false
    if scene >= 0 && self.pending[scene] != nil && !self.failed[scene]
      var item = self.pending[scene]
      self.pending[scene] = nil
      self.current_scene = scene
      self.current_priority = item.find("priority")
      self.current_started = now_ms()
      self.current_duration_ms = (scene == 3 || scene == 4) ? self.alarm_ms : self.display_ms
      self.manual_idle = false
      if self.wake_display display.power(true) end
    else
      # Device-menu/manual Show may enter the app without an event. Paint the
      # quiet frame briefly; it must not manufacture an event scene.
      self.current_scene = -1
      self.current_priority = 0
      self.current_started = now_ms()
      self.current_duration_ms = self.display_ms
      self.idle_started = self.current_started
      self.manual_idle = true
    end
    self.shown = true
  end

  def on_hide()
    self.shown = false
    self.manual_idle = false
    self.current_scene = -1
    self.current_started = nil
    self.current_priority = 0
    self.current_duration_ms = self.display_ms
    self.cancelled_request = false
  end

  def loop()
    self.expire()
    if !self.shown && self.current_scene < 0 self.request_show() end
  end

  def duration()
    return self.current_duration_ms
  end

  def on_button(button)
    if button != "select" return false end
    for scene : 0 .. size(self.names) - 1
      self.pending[scene] = nil
      self.failed[scene] = false
    end
    self.request_scene = -1
    self.show_requested = false
    self.cancelled_request = false
    self.current_scene = -1
    self.current_started = nil
    self.manual_idle = false
    rotation.next()
    return true
  end

  def draw()
    var scene = self.current_scene
    var elapsed_ms = scene >= 0 ? self.elapsed(self.current_started) : self.elapsed(self.idle_started)
    var labels = self.show_labels && scene >= 0
    self.paint(scene, elapsed_ms, labels)
  end
end
return EventTrigger()
